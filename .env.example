# WeChat Official Account API credentials
WECHAT_APP_ID=your_app_id_here
WECHAT_APP_SECRET=your_app_secret_here

# Serper.dev API Key for Google search
SERPER_API_KEY=your_serper_key_here

# AnySearch API Key for fallback search
ANYSEARCH_API_KEY=your_anysearch_key_here

# Jina AI Reader API Key for fetch fallback
JINA_API_KEY=your_jina_key_here

# LLM API Keys (DeepSeek, OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_key_here
LLM_API_KEY=your_llm_key_here

# Reddit API credentials (optional; app-only OAuth for reddit source.
# Without them the collector falls back to Reddit public JSON endpoints.)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=your_bot_user_agent_here

# Optional: Preferred model overrides (see lib/models.py). OpenRouter auth uses LLM_API_KEY.
# 写作/选题/润色走强模型（Gemini 3.7 Flash，经 OpenRouter）；批量环节走便宜 DeepSeek。
# MODEL_WRITING=google/gemini-3.7-flash   # 公众号写作
# MODEL_TOPIC=google/gemini-3.7-flash     # 选题/素材打分与聚类打标签
# MODEL_POLISH=google/gemini-3.7-flash    # 润色
# MODEL_CASE=deepseek/deepseek-v4-flash   # 案例拆解
# MODEL_FILTER=deepseek/deepseek-v4-flash # 素材过滤
# MODEL_SYNTHESIS=deepseek/deepseek-v4-flash  # 周度整合
# MODEL_FRAMEWORK=deepseek/deepseek-v4-flash  # 框架文章
